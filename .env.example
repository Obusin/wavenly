# Copy to .env.local and fill in. .env.local is gitignored.
# In production these are set in Cloudflare Pages → Settings → Variables and Secrets.

# Resend API key. Create at https://resend.com/api-keys
# Treat like a password: it can send mail as your verified domain.
RESEND_API_KEY=

# Must be a sender on a domain verified in Resend.
RESEND_FROM="Wavenly <hello@yourdomain.com>"

# Where inquiry emails land. This inbox is the record — there is no database.
WAVENLY_INBOX=hello.wavenly@gmail.com

# Public origin, used to build the reply links inside inquiry emails.
SITE_URL=https://wavenly.com

# Signs the reply links. Any long random string; changing it invalidates
# every reply link already sitting in your inbox.
# Generate with: openssl rand -hex 32
SIGNING_SECRET=

# Second factor for /studio, so a leaked reply link alone cannot send mail.
STUDIO_PASSCODE=
